            "skip_crds": false,
            "status": "deployed",
            "timeout": 300,
            "upgrade_install": null,
            "values": null,
            "verify": false,
            "version": "10.4.2",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
